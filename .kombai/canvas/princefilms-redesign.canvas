      "html": "<style>\n  @import url('https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,400..800&family=Instrument+Sans:ital,wght@0,400..700;1,400..600&display=swap');\n  @import url('https://cdn.jsdelivr.net/npm/lucide-static@1.48.0/font/lucide.css');\n\n  :root {\n    --ink-950: #050505;\n    --ink-900: #0A0A0C;\n    --ink-850: #0F0F13;\n    --ink-800: #16161C;\n    --text: #F4F0F9;\n    --muted: #9D94AC;\n    --brand-500: #9552E3;\n    --brand-400: #AE79F2;\n    --brand-300: #C5A0FA;\n    --gold: #F8C15C;\n    --mint: #74E4B6;\n  }\n\n  .pf-page {\n    background: var(--ink-950);\n    color: var(--text);\n    font-family: 'Instrument Sans', ui-sans-serif, system-ui, sans-serif;\n    -webkit-font-smoothing: antialiased;\n    -moz-osx-font-smoothing: grayscale;\n  }\n\n  .font-display {\n    font-family: 'Bricolage Grotesque', ui-sans-serif, system-ui, sans-serif;\n    letter-spacing: -0.025em;\n  }\n\n  .num { font-variant-numeric: tabular-nums; }\n\n  .pf-page a { text-decoration: none; }\n\n  .poster-img {\n    transition: transform 700ms cubic-bezier(0.22, 1, 0.36, 1);\n  }\n  .group:hover .poster-img { transform: scale(1.05); }\n\n  /* Comparison list: keep the interpreter column wide enough for full names. */\n  .pf-popular a {\n    grid-template-columns: 76px minmax(0, 1fr) 120px 46px 76px;\n    column-gap: 14px;\n  }\n</style>\n<div class=\"pf-page relative min-h-screen\" data-kid=\"1\" data-name=\"page layout container\">\n<!-- ============ CINEMATIC BACKGROUND (fixed, whole page) ============ -->\n<div aria-hidden=\"true\" class=\"pointer-events-none fixed inset-0 z-0 overflow-hidden\" data-kid=\"1-1\" data-name=\"cinematic fixed background layer\">\n<img alt=\"\" class=\"h-full w-full object-cover\" data-kid=\"1-1-1\" data-name=\"full-page cinematic background image\" decoding=\"async\" src=\"https://kombai-assets.b-cdn.net/generated_assets/a3510a37-bb7e-4808-b36f-783467f06079/9b4f8c28adc24778aca7dcbf3a8fe05c.jpg\"/>\n<div class=\"absolute inset-0 bg-[#050505]/62\" data-kid=\"1-1-2\" data-name=\"dark overlay for background false\"></div>\n<div class=\"absolute inset-0 bg-gradient-to-b from-[#050505]/45 via-[#050505]/80 to-[#050505]\" data-kid=\"1-1-3\" data-name=\"vertical background gradient overlay\"></div>\n</div>\n<div class=\"relative z-10\" data-kid=\"1-2\" data-name=\"page content wrapper above background\">\n<!-- ============ NAV ============ -->\n<header class=\"sticky top-0 z-40 h-[76px] border-b border-white/[0.06] bg-[#050505]/70 backdrop-blur-xl\" data-kid=\"1-2-1\" data-name=\"sticky site header bar\">\n<div class=\"mx-auto flex h-full max-w-[1440px] items-center gap-7 px-6 lg:px-10\" data-kid=\"1-2-1-1\" data-name=\"header inner container\">\n<a aria-label=\"PRINCEFILMS home\" class=\"flex shrink-0 items-center gap-2.5\" data-kid=\"1-2-1-1-1\" data-name=\"brand home logo link\" href=\"/\">\n<span class=\"relative grid size-[34px] place-items-center overflow-hidden rounded-[10px] bg-gradient-to-br from-[#9552E3] via-[#7B2CBF] to-[#48156F] shadow-[0_10px_24px_-12px_rgba(123,44,191,1)] ring-1 ring-inset ring-white/20\" data-kid=\"1-2-1-1-1-1\" data-name=\"logo tile with gradient background\">\n<svg aria-hidden=\"true\" data-kid=\"1-2-1-1-1-1-1\" data-name=\"play triangle logo icon\" height=\"14\" viewbox=\"0 0 24 24\" width=\"14\">\n<path d=\"M8.5 5.4v13.2L19 12z\" fill=\"#ffffff\"></path>\n</svg>\n</span>\n<span class=\"font-display text-[16px] font-bold leading-none tracking-[-0.03em] text-white\" data-kid=\"1-2-1-1-1-2\" data-name=\"brand wordmark text\">\n            PRINCE<span class=\"text-[#C5A0FA]\" data-kid=\"1-2-1-1-1-2-1\" data-name=\"brand wordmark accent (FILMS)\">FILMS</span>\n</span>\n</a>\n<nav aria-label=\"Primary\" class=\"hidden h-full items-center gap-7 text-[13.5px] md:flex\" data-kid=\"1-2-1-1-2\" data-name=\"primary horizontal navigation\">\n<a aria-current=\"page\" class=\"relative flex h-full items-center font-medium text-white\" data-kid=\"1-2-1-1-2-1\" data-name=\"active Home nav link with underline\" href=\"/\">\n            Home\n            <span aria-hidden=\"true\" class=\"absolute inset-x-0 bottom-0 h-[2px] rounded-full bg-[#9552E3]\" data-kid=\"1-2-1-1-2-1-1\" data-name=\"active nav underline indicator\"></span>\n</a>\n<a class=\"flex h-full items-center font-medium text-white/50 transition-colors duration-200 hover:text-white\" data-kid=\"1-2-1-1-2-2\" data-name=\"Movies nav link\" href=\"/movies\">Movies</a>\n<a class=\"flex h-full items-center font-medium text-white/50 transition-colors duration-200 hover:text-white\" data-kid=\"1-2-1-1-2-3\" data-name=\"Series nav link\" href=\"/series\">Series</a>\n<a class=\"flex h-full items-center font-medium text-white/50 transition-colors duration-200 hover:text-white\" data-kid=\"1-2-1-1-2-4\" data-name=\"Categories nav link\" href=\"/categories\">Categories</a>\n<a class=\"flex h-full items-center font-medium text-white/50 transition-colors duration-200 hover:text-white\" data-kid=\"1-2-1-1-2-5\" data-name=\"Interpreters nav link\" href=\"/interpreters\">Interpreters</a>\n</nav>\n<div class=\"ml-auto flex items-center gap-2.5\" data-kid=\"1-2-1-1-3\" data-name=\"header action group\">\n<button aria-label=\"Search titles and interpreters\" class=\"hidden h-9 items-center gap-2 rounded-lg border border-white/[0.08] bg-white/[0.04] px-3 text-[13px] text-white/45 transition-colors duration-200 hover:border-white/15 hover:text-white/80 sm:flex lg:w-[218px]\" data-kid=\"1-2-1-1-3-1\" data-name=\"search launch button with shortcut\" type=\"button\">\n<i aria-hidden=\"true\" class=\"icon-search\" data-kid=\"1-2-1-1-3-1-1\" data-name=\"search magnifier icon\" style=\"font-size:15px\"></i>\n<span class=\"flex-1 text-left\" data-kid=\"1-2-1-1-3-1-2\" data-name=\"search button label\">Search titles</span>\n<kbd class=\"rounded border border-white/10 px-1.5 py-0.5 text-[10px] font-medium leading-none text-white/35\" data-kid=\"1-2-1-1-3-1-3\" data-name=\"keyboard shortcut hint badge\">⌘K</kbd>\n</button>\n<a class=\"hidden h-9 items-center px-2 text-[13px] font-medium text-white/60 transition-colors duration-200 hover:text-white sm:inline-flex\" data-kid=\"1-2-1-1-3-2\" data-name=\"sign-in link\" href=\"/login\">Sign in</a>\n<a class=\"inline-flex h-9 items-center rounded-lg bg-[#9552E3] px-4 text-[13px] font-semibold text-white shadow-[0_10px_26px_-14px_rgba(149,82,227,1)] transition-colors duration-200 hover:bg-[#AE79F2]\" data-kid=\"1-2-1-1-3-3\" data-name=\"sign-up call-to-action button\" href=\"/register\">Sign Up</a>\n</div>\n</div>\n</header>\n<main class=\"mx-auto w-full max-w-[1440px] px-6 lg:px-10\" data-kid=\"1-2-2\" data-name=\"main content region\">\n<!-- ============ HERO ============ -->\n<section aria-labelledby=\"featured-title\" class=\"relative mt-5 h-[380px] overflow-hidden rounded-[20px] ring-1 ring-white/[0.09]\" data-kid=\"1-2-2-1\" data-name=\"featured hero section\">\n<img alt=\"Kigali Nocturne — film still, photo by Alan Villegas on Unsplash\" class=\"absolute inset-0 size-full object-cover object-center\" data-kid=\"1-2-2-1-1\" data-name=\"hero background film still\" decoding=\"async\" height=\"900\" src=\"https://images.unsplash.com/photo-1787692141412-9a0fb5202213?auto=format&amp;fit=crop&amp;w=1600&amp;q=80\" width=\"1600\"/>\n<div aria-hidden=\"true\" class=\"absolute inset-0 bg-gradient-to-t from-[#050505] via-[#050505]/40 to-transparent\" data-kid=\"1-2-2-1-2\" data-name=\"hero bottom gradient overlay\"></div>\n<div aria-hidden=\"true\" class=\"absolute inset-0 bg-gradient-to-r from-[#050505]/75 via-[#050505]/20 to-transparent\" data-kid=\"1-2-2-1-3\" data-name=\"hero left gradient overlay\"></div>\n<div class=\"absolute inset-x-0 bottom-0 p-6 sm:p-8\" data-kid=\"1-2-2-1-4\" data-name=\"hero content bar\">\n<div class=\"flex flex-wrap items-end justify-between gap-x-8 gap-y-5\" data-kid=\"1-2-2-1-4-1\" data-name=\"hero content row\">\n<div class=\"min-w-0 max-w-[680px]\" data-kid=\"1-2-2-1-4-1-1\"