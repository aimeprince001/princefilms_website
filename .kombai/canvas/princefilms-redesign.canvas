      "html": "<style>\n  @import url('https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,400..800&family=Instrument+Sans:ital,wght@0,400..700;1,400..600&display=swap');\n  @import url('https://cdn.jsdelivr.net/npm/lucide-static@1.48.0/font/lucide.css');\n\n  html { -webkit-font-smoothing: antialiased; -moz-osx-font-smoothing: grayscale; }\n  body {\n    margin: 0;\n    background: #050505;\n    color: #F4F0F9;\n    font-family: 'Instrument Sans', ui-sans-serif, system-ui, sans-serif;\n    font-feature-settings: \"ss01\" on;\n  }\n  .display { font-family: 'Bricolage Grotesque', ui-sans-serif, system-ui, sans-serif; }\n  .num { font-variant-numeric: tabular-nums; letter-spacing: -0.01em; }\n  .no-bar { scrollbar-width: none; -ms-overflow-style: none; }\n  .no-bar::-webkit-scrollbar { display: none; }\n  .glass { background: rgba(15,15,19,0.68); backdrop-filter: blur(20px); }\n  /* Fixed cinematic film-reel ground */\n  .reel {\n    position: fixed; inset: 0; z-index: -10; overflow: hidden; background: #050505;\n  }\n  .reel img {\n    height: 100%; width: 100%; object-fit: cover;\n    filter: brightness(0.74) saturate(0.95) blur(2.5px);\n    transform: scale(1.08);\n  }\n  .reel::after {\n    content: \"\"; position: absolute; inset: 0;\n    background:\n      linear-gradient(180deg, rgba(5,5,5,0.40) 0%, rgba(5,5,5,0.58) 26%, rgba(5,5,5,0.80) 58%, rgba(5,5,5,0.93) 82%, #050505 100%),\n      radial-gradient(130% 70% at 8% 0%, rgba(5,5,5,0) 0%, rgba(5,5,5,0.26) 75%);\n  }\n  /* Stills sit on a black ground, so lift them slightly to stay legible. */\n  img[src*=\"images.unsplash.com\"] { filter: brightness(1.12) contrast(1.03) saturate(1.02); }\n</style>\n<div aria-hidden=\"true\" class=\"reel\" data-kid=\"1\">\n<img alt=\"\" data-kid=\"1-1\" decoding=\"async\" src=\"https://kombai-assets.b-cdn.net/generated_assets/a3510a37-bb7e-4808-b36f-783467f06079/9b4f8c28adc24778aca7dcbf3a8fe05c.jpg\"/>\n</div>\n<div class=\"relative min-h-screen w-full\