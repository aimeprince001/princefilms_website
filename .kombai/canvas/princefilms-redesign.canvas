      "html": "<style>\n  @import url('https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,400..800&family=Instrument+Sans:ital,wght@0,400..700;1,400..600&display=swap');\n  @import url('https://cdn.jsdelivr.net/npm/lucide-static@1.48.0/font/lucide.css');\n\n  :root{\n    --ink-950:#050505;\n    --ink-900:#0A0A0C;\n    --ink-850:#0F0F13;\n    --ink-800:#16161C;\n    --text:#F4F0F9;\n    --muted:#9D94AC;\n    --brand-300:#C5A0FA;\n    --brand-400:#AE79F2;\n    --brand-500:#9552E3;\n    --brand-600:#7B2CBF;\n    --gold:#F8C15C;\n    --mint:#74E4B6;\n  }\n\n  html{ -webkit-text-size-adjust:100%; scroll-behavior:smooth; }\n  body{\n    margin:0;\n    background:#050505;\n    color:var(--text);\n    font-family:'Instrument Sans', ui-sans-serif, system-ui, sans-serif;\n    -webkit-font-smoothing:antialiased;\n    -moz-osx-font-smoothing:grayscale;\n    overflow-x:hidden;\n  }\n  .display{ font-family:'Bricolage Grotesque', ui-sans-serif, system-ui, sans-serif; letter-spacing:-0.028em; }\n  .num{ font-variant-numeric:tabular-nums; letter-spacing:-0.01em; }\n  .hide-scrollbar{ scrollbar-width:none; -ms-overflow-style:none; }\n  .hide-scrollbar::-webkit-scrollbar{ display:none; }\n  .still{ filter:saturate(0.95) contrast(1.04) brightness(0.95); }\n  a{ color:inherit; text-decoration:none; }\n  a:focus-visible, button:focus-visible{ outline:2px solid var(--brand-400); outline-offset:3px; border-radius:8px; }\n</style>\n<!-- ============ FIXED CINEMATIC GROUND ============ -->\n<div aria-hidden=\"true\" class=\"fixed inset-0 -z-10 overflow-hidden\" data-kid=\"1\">\n<img alt=\"\" class=\"h-full w-full object-cover object-center\" data-kid=\"1-1\" decoding=\"async\" loading=\"lazy\" src=\"https://kombai-assets.b-cdn.net/generated_assets/a3510a37-bb7e-4808-b36f-783467f06079/9b4f8c28adc24778aca7dcbf3a8fe05c.jpg\"/>\n<div class=\"absolute inset-0 bg-[#050505]/50\" data-kid=\"1-2\"></div>\n<div class=\"absolute inset-0 bg-gradient-to-b from-[#050505]/82 via